# Copy to .env and fill in the two keys. Never commit .env.

# Required
CEREBRAS_API_KEY=
COHERE_API_KEY=

# Optional (defaults shown)
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_REASONING_EFFORT=medium
# COHERE_RERANK_MODEL=rerank-v4.0-pro
# FILINGLENS_QUERY_PER_MIN=10
# FILINGLENS_RETRIEVE_PER_MIN=30
# FILINGLENS_CACHE_PATH=data/PROCESSED/cache.db
# FILINGLENS_TRACE_PATH=data/PROCESSED/traces.db
# FILINGLENS_TRACE_RETENTION_DAYS=30

# Cost estimates in traces (USD; list-price estimates -- set 0 for free trial keys)
# FILINGLENS_PRICE_LLM_INPUT_PER_M=0.35
# FILINGLENS_PRICE_LLM_OUTPUT_PER_M=0.75
# FILINGLENS_PRICE_RERANK_PER_CALL=0.002
