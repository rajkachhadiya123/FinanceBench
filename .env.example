# Copy to .env and fill in the two keys. Never commit .env.

# Required
DEEPSEEK_API_KEY=
COHERE_API_KEY=
# CEREBRAS_API_KEY=            # retired; see answer_generator.py

# Optional (defaults shown)
# DEEPSEEK_MODEL=deepseek-flash       # or deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=high      # low / high / max
# DEEPSEEK_MAX_TOKENS=8000
# COHERE_RERANK_MODEL=rerank-v4.0-pro
